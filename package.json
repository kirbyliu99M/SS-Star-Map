{
  "name": "ss-star-map",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "db:push:staging": "supabase db push --linked",
    "db:ping:staging": "node scripts/ping-staging.mjs",
    "e2e": "turbo run build --filter=web && pnpm --filter web e2e"
  },
  "devDependencies": {
    "supabase": "2.122.0",
    "turbo": "2.11.10"
  }
}
